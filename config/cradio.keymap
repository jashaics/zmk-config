/*
 * Ferris Sweep (cradio) - ZMK - layout per italiano + programmazione
 *
 * IMPORTANTE: sul computer lascia il layout di tastiera ITALIANO.
 * I simboli qui sotto (IT_...) sono gia' tradotti per il layout italiano
 * di Windows/Linux. Su macOS il layout italiano e' diverso.
 *
 * Livelli:
 *   BASE  QWERTY con "home row mods" (tieni premuto A S D F / J K L ' = Win Alt Ctrl Shift)
 *   NAV   tieni premuto il pollice SINISTRO esterno (Tab): frecce, pagine, copia/incolla
 *   SYM   tieni premuto il pollice DESTRO interno (Backspace): parentesi e simboli
 *   NUM   tieni premuto il pollice DESTRO esterno (Invio): numeri, accentate, F1-F10
 *   ADJ   NAV + NUM insieme: Bluetooth, USB/BLE, bootloader
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>

#define BASE 0
#define NAV  1
#define SYM  2
#define NUM  3
#define ADJ  4

/* ---- Simboli per il layout ITALIANO del sistema operativo ---- */
#define IT_AGRV  SQT              /* a' */
#define IT_EGRV  LBKT             /* e' (e grave) */
#define IT_EACU  LS(LBKT)         /* e' (e acuta) */
#define IT_IGRV  EQUAL            /* i' */
#define IT_OGRV  SEMI             /* o' */
#define IT_UGRV  BSLH             /* u' */
#define IT_APOS  MINUS            /* '  apostrofo */
#define IT_QUES  LS(MINUS)        /* ? */
#define IT_PLUS  RBKT             /* + */
#define IT_STAR  LS(RBKT)         /* * */
#define IT_MINS  SLASH            /* - */
#define IT_UNDS  LS(SLASH)        /* _ */
#define IT_EXCL  LS(N1)           /* ! */
#define IT_DQUO  LS(N2)           /* " */
#define IT_DLR   LS(N4)           /* $ */
#define IT_PERC  LS(N5)           /* % */
#define IT_AMPR  LS(N6)           /* & */
#define IT_SLSH  LS(N7)           /* / */
#define IT_LPRN  LS(N8)           /* ( */
#define IT_RPRN  LS(N9)           /* ) */
#define IT_EQL   LS(N0)           /* = */
#define IT_CIRC  LS(EQUAL)        /* ^ */
#define IT_SCLN  LS(COMMA)        /* ; */
#define IT_COLN  LS(DOT)          /* : */
#define IT_LT    NON_US_BACKSLASH /* < */
#define IT_GT    LS(NON_US_BACKSLASH) /* > */
#define IT_BSLS  GRAVE            /* \ */
#define IT_PIPE  LS(GRAVE)        /* | */
#define IT_LBRC  RA(LBKT)         /* [ */
#define IT_RBRC  RA(RBKT)         /* ] */
#define IT_LCBR  RA(LS(LBKT))     /* { */
#define IT_RCBR  RA(LS(RBKT))     /* } */
#define IT_AT    RA(SEMI)         /* @ */
#define IT_HASH  RA(SQT)          /* # */
#define IT_TILD  RA(EQUAL)        /* ~  (solo Linux; su Windows: Alt+126) */
#define IT_GRV   RA(MINUS)        /* `  (solo Linux; su Windows: Alt+96) */

/ {
    behaviors {
        /* home row mods mano sinistra: si attivano solo se premi un tasto con l'altra mano */
        hml: home_row_mod_left {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            bindings = <&kp>, <&kp>;
            hold-trigger-key-positions = <5 6 7 8 9 15 16 17 18 19 25 26 27 28 29 30 31 32 33>;
            hold-trigger-on-release;
        };
        hmr: home_row_mod_right {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            bindings = <&kp>, <&kp>;
            hold-trigger-key-positions = <0 1 2 3 4 10 11 12 13 14 20 21 22 23 24 30 31 32 33>;
            hold-trigger-on-release;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";
        adjust {
            if-layers = <NAV NUM>;
            then-layer = <ADJ>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base_layer {
            bindings = <
    &kp Q          &kp W          &kp E           &kp R           &kp T            &kp Y   &kp U           &kp I           &kp O          &kp P
    &hml LGUI A    &hml LALT S    &hml LCTRL D    &hml LSHFT F    &kp G            &kp H   &hmr RSHFT J    &hmr RCTRL K    &hmr LALT L    &hmr RGUI IT_APOS
    &kp Z          &kp X          &kp C           &kp V           &kp B            &kp N   &kp M           &kp COMMA       &kp DOT        &kp IT_MINS
                                                  &lt NAV TAB     &kp SPACE        &lt SYM BSPC    &lt NUM RET
            >;
        };

        nav_layer {
            bindings = <
    &kp ESC        &kp F11        &kp F12         &kp CAPS        &kp PSCRN        &kp PG_UP    &kp HOME    &kp UP       &kp END      &kp DEL
    &kp LGUI       &kp LALT       &kp LCTRL       &kp LSHFT       &kp INS          &kp PG_DN    &kp LEFT    &kp DOWN     &kp RIGHT    &kp BSPC
    &kp LC(Z)      &kp LC(X)      &kp LC(C)       &kp LC(V)       &kp LC(Y)        &kp C_MUTE   &kp C_VOL_DN &kp C_VOL_UP &kp C_PP    &kp C_NEXT
                                                  &trans          &trans           &kp ESC      &trans
            >;
        };

        sym_layer {
            bindings = <
    &kp IT_EXCL    &kp IT_AT      &kp IT_HASH     &kp IT_DLR      &kp IT_PERC      &kp IT_CIRC  &kp IT_AMPR &kp IT_STAR  &kp IT_QUES  &kp IT_DQUO
    &kp IT_LT      &kp IT_LCBR    &kp IT_LBRC     &kp IT_LPRN     &kp IT_EQL       &kp IT_PLUS  &kp IT_RPRN &kp IT_RBRC  &kp IT_RCBR  &kp IT_GT
    &kp IT_BSLS    &kp IT_PIPE    &kp IT_TILD     &kp IT_GRV      &kp IT_UNDS      &kp IT_MINS  &kp IT_SLSH &kp IT_SCLN  &kp IT_COLN  &kp IT_APOS
                                                  &kp TAB         &kp SPACE        &trans       &trans
            >;
        };

        num_layer {
            bindings = <
    &kp IT_AGRV    &kp IT_EGRV    &kp IT_EACU     &kp IT_IGRV     &kp IT_OGRV      &kp IT_UGRV  &kp IT_PLUS &kp IT_MINS  &kp IT_STAR  &kp IT_SLSH
    &kp N1         &kp N2         &kp N3          &kp N4          &kp N5           &kp N6       &kp N7      &kp N8       &kp N9       &kp N0
    &kp F1         &kp F2         &kp F3          &kp F4          &kp F5           &kp F6       &kp F7      &kp F8       &kp F9       &kp F10
                                                  &trans          &trans           &kp DOT      &trans
            >;
        };

        adj_layer {
            bindings = <
    &bt BT_SEL 0   &bt BT_SEL 1   &bt BT_SEL 2    &bt BT_SEL 3    &bt BT_SEL 4     &bootloader  &none       &none        &none        &bootloader
    &bt BT_PRV     &bt BT_NXT     &bt BT_CLR      &out OUT_USB    &out OUT_BLE     &sys_reset   &none       &none        &none        &sys_reset
    &none          &none          &none           &none           &bt BT_CLR_ALL   &none        &none       &none        &none        &none
                                                  &trans          &none            &none        &trans
            >;
        };
    };
};
